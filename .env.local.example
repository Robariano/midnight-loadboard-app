# Copy this file to .env.local and fill in your real values.
# You'll find these in your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ADMIN_PASSWORD=pick-a-password-only-you-know

# Twilio — used to auto-text drivers their coverage confirmation link.
# Find these in the Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Used to build the absolute confirmation link sent via SMS.
APP_BASE_URL=https://midnightloadboard.com

# Resend — used to email drivers their coverage confirmation link when
# driver_contact is an email address instead of a phone number.
# Free account: https://resend.com — RESEND_FROM_EMAIL must be on a domain
# you've verified in Resend (or use their onboarding@resend.dev for testing).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Midnight Loadboard <notifications@midnightloadboard.com>

# FMCSA — used by the admin "Check FMCSA" button to pull live carrier
# registration/safety data by DOT number. Free key, requires a Login.gov
# account: https://mobile.fmcsa.dot.gov/QCDevsite/logingovInfo
FMCSA_WEB_KEY=your-fmcsa-webkey-here

# Secures the daily insurance-expiration cron job (see vercel.json). Vercel
# automatically sends this as "Authorization: Bearer <value>" when it
# triggers scheduled Cron Jobs, as long as this env var is set in your
# Vercel project — pick any long random string.
CRON_SECRET=pick-a-long-random-string
