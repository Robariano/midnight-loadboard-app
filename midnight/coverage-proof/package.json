{
  "name": "nightlane-midnight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nightlane coverage proof on Midnight: carriers prove insurance meets a minimum without sharing their COI.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contract/coverage-proof.compact contract/managed/coverage-proof",
    "compile:fast": "compact compile --skip-zk contract/coverage-proof.compact contract/managed/coverage-proof",
    "test": "node test/coverage-proof.test.mjs",
    "typecheck": "tsc --noEmit -p .",
    "deploy:preview": "tsx scripts/deploy.ts --network=preview",
    "deploy:mainnet": "tsx scripts/deploy.ts --network=mainnet",
    "carrier:new": "tsx scripts/carrier-new.ts",
    "attest": "tsx scripts/attest.ts",
    "prove": "tsx scripts/prove.ts",
    "check": "tsx scripts/check.ts",
    "worker": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnight-ntwrk/midnight-js-utils": "5.0.1",
    "@midnight-ntwrk/testkit-js": "5.0.1",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnightntwrk/zkir-v3": "3.2.1"
  }
}
